export HOME="/opt/expressvpn/vpnns1"
export INSTANCE_ROOT="/opt/expressvpn/vpnns1"
export PATH="/opt/expressvpn/vpnns1/bin:$PATH"
export LD_LIBRARY_PATH="/opt/expressvpn/vpnns1/lib:${LD_LIBRARY_PATH:-}"
export EXPRESSVPN_ETC="/opt/expressvpn/vpnns1/etc"
export EXPRESSVPN_VAR="/opt/expressvpn/vpnns1/var"
export EXPRESSVPN_SHARE="/opt/expressvpn/vpnns1/share"
export EXPRESSVPN_PLUGINS="/opt/expressvpn/vpnns1/plugins"
export EXPRESSVPN_QML="/opt/expressvpn/vpnns1/qml"
alias expressvpnctl="/opt/expressvpn/vpnns1/bin/expressvpnctl"
